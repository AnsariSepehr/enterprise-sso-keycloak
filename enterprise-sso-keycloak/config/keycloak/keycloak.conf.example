# /opt/keycloak/conf/keycloak.conf
# Keycloak listens on localhost only; nginx terminates HTTPS in front of it.
hostname=${SSO_HOSTNAME}
http-enabled=true
http-host=127.0.0.1
http-port=8080
proxy-headers=xforwarded

db=postgres
db-username=${DB_USER}
db-url=jdbc:postgresql://127.0.0.1:5432/${DB_NAME}
# db-password is NOT stored here. It is passed as KC_DB_PASSWORD from
# /etc/keycloak/keycloak.env (mode 600), see keycloak.service.

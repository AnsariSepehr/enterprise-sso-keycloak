# ${ZEPPELIN_HOME}/conf/shiro.ini  (owner zeppelin, mode 640)
[users]
# Intentionally empty. All authentication comes from Knox SSO.
# Do NOT add sample users (user1/password2 ...): with a user list present,
# Shiro could also accept password logins against it and bypass the SSO.

[main]
### Knox SSO realm (login via Knox -> Keycloak)
knoxJwtRealm = org.apache.zeppelin.realm.jwt.KnoxJwtRealm
knoxJwtRealm.providerUrl = https://${KNOX_HOSTNAME}/
knoxJwtRealm.login = gateway/knoxsso/api/v1/websso
knoxJwtRealm.logout = logout
knoxJwtRealm.logoutAPI = false
knoxJwtRealm.redirectParam = originalUrl
knoxJwtRealm.cookieName = hadoop-jwt
knoxJwtRealm.publicKeyPath = ${ZEPPELIN_HOME}/conf/knox-sso.pem

authc = org.apache.zeppelin.realm.jwt.KnoxAuthenticationFilter

# Explicit, so only the Knox realm is ever used
securityManager.realms = $knoxJwtRealm

sessionManager = org.apache.shiro.web.session.mgt.DefaultWebSessionManager

### Enables 'HttpOnly' flag in Zeppelin cookies
cookie = org.apache.shiro.web.servlet.SimpleCookie
cookie.name = JSESSIONID
cookie.httpOnly = true
cookie.sameSite = LAX
sessionManager.sessionIdCookie = $cookie

securityManager.sessionManager = $sessionManager
# 86,400,000 ms = 24 h (same as the Knox token lifetime)
securityManager.sessionManager.globalSessionTimeout = 86400000
shiro.loginUrl = /api/login

[roles]
role1 = *
role2 = *
role3 = *
admin = *

[urls]
/api/version = anon
/api/cluster/address = anon
/api/interpreter/setting/restart/** = authc
/api/interpreter/** = authc, roles[admin]
/api/notebook-repositories/** = authc, roles[admin]
/api/configurations/** = authc, roles[admin]
/api/credential/** = authc, roles[admin]
/api/admin/** = authc, roles[admin]
/** = authc

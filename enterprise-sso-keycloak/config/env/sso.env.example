# Copy to sso.env (git-ignored) and edit. NO secrets in this file:
# scripts ask for passwords interactively or read them from the environment.

# --- naming (everything below is a placeholder) ---
DOMAIN=example.corp
SSO_HOSTNAME=sso.example.corp
KNOX_HOSTNAME=knox.example.corp
JIRA_HOSTNAME=jira.example.corp
ZEPPELIN_HOSTNAME=zeppelin.example.corp
REALM=CORP

# --- versions we deployed ---
KEYCLOAK_VERSION=26.7.4
KNOX_VERSION=2.1.0
OIDC_SDK_VERSION=9.13

# --- paths ---
KEYCLOAK_HOME=/opt/keycloak
KNOX_HOME=/opt/knox
ZEPPELIN_HOME=/opt/zeppelin-0.12.1-bin-all
HADOOP_HOME=/opt/hadoop
TLS_CERT=/etc/nginx/certs/certs.pem
TLS_KEY=/etc/nginx/certs/private.key

# --- database for Keycloak ---
DB_NAME=sso_db
DB_USER=sso_db_user

# --- secrets: leave unset, scripts will prompt ---
# KC_DB_PASSWORD=
# KC_BOOTSTRAP_ADMIN_PASSWORD=
# KNOX_OIDC_SECRET=

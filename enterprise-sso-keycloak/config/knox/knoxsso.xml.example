<?xml version="1.0" encoding="utf-8"?>
<!-- ${KNOX_HOME}/conf/topologies/knoxsso.xml
     KnoxSSO topology: demo LDAP login replaced by a pac4j OIDC client for Keycloak.
     Contains the client secret once rendered: mode 600, owner knox, never commit. -->
<topology>
    <gateway>
        <provider>
            <role>webappsec</role>
            <name>WebAppSec</name>
            <enabled>true</enabled>
            <param><name>xframe.options.enabled</name><value>true</value></param>
        </provider>

        <provider>
            <role>federation</role>
            <name>pac4j</name>
            <enabled>true</enabled>
            <param><name>pac4j.callbackUrl</name><value>https://${KNOX_HOSTNAME}/gateway/knoxsso/api/v1/websso</value></param>
            <param><name>clientName</name><value>OidcClient</value></param>
            <param><name>oidc.id</name><value>knox</value></param>
            <param><name>oidc.secret</name><value>${KNOX_OIDC_SECRET}</value></param>
            <param><name>oidc.discoveryUri</name><value>https://${SSO_HOSTNAME}/realms/${REALM}/.well-known/openid-configuration</value></param>
            <param><name>pac4j.id_attribute</name><value>preferred_username</value></param>
            <!-- Added while chasing the logout problem. They did NOT make Knox's own
                 logout end the Keycloak session; kept for reference only. -->
            <param><name>pac4j.centralLogout</name><value>true</value></param>
            <param><name>pac4j.logoutUrlPattern</name><value>^https?:\/\/(.*\.)?${DOMAIN_REGEX}(:[0-9]+)?(\/.*)?$</value></param>
        </provider>

        <provider>
            <role>identity-assertion</role>
            <name>Default</name>
            <enabled>true</enabled>
        </provider>

        <provider>
            <role>hostmap</role>
            <name>static</name>
            <enabled>true</enabled>
            <param><name>localhost</name><value>sandbox,sandbox.hortonworks.com</value></param>
        </provider>
    </gateway>

    <application>
        <name>knoxauth</name>
    </application>

    <service>
        <role>KNOXSSO</role>
        <!-- default is localhost only; without this: "original URL ... is not valid according to the configured whitelist" -->
        <param><name>knoxsso.redirect.whitelist.regex</name><value>^https?:\/\/(.*\.)?${DOMAIN_REGEX}(:[0-9]+)?(\/.*)?$</value></param>
        <!-- lets zeppelin.* see the hadoop-jwt cookie issued by knox.* -->
        <param><name>knoxsso.cookie.domain.suffix</name><value>.${DOMAIN}</value></param>
        <!-- 24 h in ms -->
        <param><name>knoxsso.token.ttl</name><value>86400000</value></param>
        <param><name>knox.token.exp.server-managed</name><value>false</value></param>
    </service>

    <service>
        <role>KNOXSSOUT</role>
    </service>
</topology>

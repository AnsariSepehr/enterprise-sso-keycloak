# /etc/nginx/conf.d/ranger.conf   (Ranger node)
# Ranger Admin listens on :6080 (all interfaces: Ranger plugins and usersync need it there).
# nginx adds HTTPS for browsers and carries the logout rule. docs/services/ranger.md
server {
    listen 80;
    server_name ${RANGER_HOSTNAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${RANGER_HOSTNAME};

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        # LOGOUT. With SSO on, Ranger's Logout button ends only Ranger's own session and then
        # navigates to /index.html?action=timeout. Catch that URL, expire Ranger's own session
        # cookie (the request never reaches Ranger, so Ranger cannot do it) and continue to the
        # Knox-side logout, which ends hadoop-jwt and the Keycloak session.
        # Ranger sets RANGERADMINSESSIONID without "Secure"; the expiry must use the same attributes.
        # A session timeout lands on the same URL, so a timeout becomes a full logout (intended).
        if ($request_uri ~* "^/index\.html\?(.*&)?action=timeout") {
            add_header Set-Cookie "RANGERADMINSESSIONID=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly" always;
            add_header Cache-Control "no-store" always;
            return 302 https://${KNOX_HOSTNAME}/logout/ranger;
        }

        proxy_pass http://127.0.0.1:6080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Ranger builds the return address it gives to Knox from these two headers.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # X-Forwarded-Port is left out ON PURPOSE: with it the return address gains ":443".
        proxy_read_timeout 300s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}

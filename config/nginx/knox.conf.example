# /etc/nginx/conf.d/knox.conf   (worker node)
server {
    listen 80;
    server_name ${KNOX_HOSTNAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${KNOX_HOSTNAME};

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8443;   # Knox, plain HTTP internally
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 3600s;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }

    # WORKAROUND for the Knox logout problem (docs/services/knox.md, "Logout").
    # Each location expires the Knox cookies and sends the browser to Keycloak's logout endpoint,
    # which then returns it to ONE application. Keycloak's client "knox" must list every return
    # address under "Valid post logout redirect URIs". Cookie names, domain and path must match
    # the stored cookies exactly or the browser ignores the deletion.
    # Add a block for a new application with: scripts/tools/gen-app-logout.sh <app> <hostname>

    # /logout        -> Zeppelin (what Zeppelin's classic UI calls through knoxJwtRealm.logout)
    location = /logout {
        add_header Set-Cookie "hadoop-jwt=; Domain=.${DOMAIN}; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Set-Cookie "pac4j.session.pac4jUserProfiles=; Domain=.${DOMAIN}; Path=/gateway/knoxsso/api/v1; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Set-Cookie "pac4j.session.pac4jRequestedUrl=; Domain=.${DOMAIN}; Path=/gateway/knoxsso/api/v1; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Cache-Control "no-store" always;
        return 302 https://${SSO_HOSTNAME}/realms/${REALM}/protocol/openid-connect/logout?client_id=knox&post_logout_redirect_uri=https%3A%2F%2F${ZEPPELIN_HOSTNAME}%2F;
    }

    # /logout/ranger -> Ranger (called by the nginx rule on the Ranger node, docs/services/ranger.md)
    location = /logout/ranger {
        add_header Set-Cookie "hadoop-jwt=; Domain=.${DOMAIN}; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Set-Cookie "pac4j.session.pac4jUserProfiles=; Domain=.${DOMAIN}; Path=/gateway/knoxsso/api/v1; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Set-Cookie "pac4j.session.pac4jRequestedUrl=; Domain=.${DOMAIN}; Path=/gateway/knoxsso/api/v1; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Cache-Control "no-store" always;
        return 302 https://${SSO_HOSTNAME}/realms/${REALM}/protocol/openid-connect/logout?client_id=knox&post_logout_redirect_uri=https%3A%2F%2F${RANGER_HOSTNAME}%2F;
    }

    # /logout/knox   -> the Knox home page (the original behaviour of /logout)
    location = /logout/knox {
        add_header Set-Cookie "hadoop-jwt=; Domain=.${DOMAIN}; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Set-Cookie "pac4j.session.pac4jUserProfiles=; Domain=.${DOMAIN}; Path=/gateway/knoxsso/api/v1; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Set-Cookie "pac4j.session.pac4jRequestedUrl=; Domain=.${DOMAIN}; Path=/gateway/knoxsso/api/v1; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly" always;
        add_header Cache-Control "no-store" always;
        return 302 https://${SSO_HOSTNAME}/realms/${REALM}/protocol/openid-connect/logout?client_id=knox&post_logout_redirect_uri=https%3A%2F%2F${KNOX_HOSTNAME}%2Fgateway%2Fhomepage%2Fhome%2F;
    }
}

# Copy to sso.env (git-ignored) and edit. NO secrets in this file:
# scripts ask for passwords interactively or read them from the environment.

# --- naming (everything below is a placeholder) ---
DOMAIN=example.corp
SSO_HOSTNAME=sso.example.corp
KNOX_HOSTNAME=knox.example.corp
JIRA_HOSTNAME=jira.example.corp
ZEPPELIN_HOSTNAME=zeppelin.example.corp
RANGER_HOSTNAME=ranger.example.corp
GRAFANA_HOSTNAME=dashboards.example.corp
NEXTCLOUD_HOSTNAME=nextcloud.example.corp
MAIL_HOSTNAME=mail.example.corp
REALM=CORP

# --- versions we deployed ---
KEYCLOAK_VERSION=26.7.4
KNOX_VERSION=2.1.0
OIDC_SDK_VERSION=9.13
RANGER_VERSION=2.6.0
GRAFANA_VERSION=13.2.0
NEXTCLOUD_VERSION=30.0.5

# --- paths ---
KEYCLOAK_HOME=/opt/keycloak
KNOX_HOME=/opt/knox
ZEPPELIN_HOME=/opt/zeppelin-0.12.1-bin-all
HADOOP_HOME=/opt/hadoop
TLS_CERT=/etc/nginx/certs/certs.pem
TLS_KEY=/etc/nginx/certs/private.key
RANGER_CONF_DIR=/etc/ranger/admin/conf.dist
KNOX_CERT_FILE=/root/knox-sso.pem          # copy of Knox's PEM certificate, placed on the Ranger node

# --- who may administer what (user names as Keycloak sends them: preferred_username) ---
ZEPPELIN_ADMINS="j.doe, a.smith"           # comma separated, goes into the shiro.ini admin rules
GRAFANA_ADMIN_GROUP=grafana-admins         # Keycloak group whose members become Grafana administrators

# --- container platform (Grafana runs in Docker Swarm, Nextcloud in a single container) ---
SWARM_STACK=grafana
NEXTCLOUD_CONTAINER=app
GRAFANA_SECRET_MODE=env                    # env is the verified method; the docker-secret mode is recommended but unverified

# --- database for Keycloak ---
DB_NAME=sso_db
DB_USER=sso_db_user

# --- secrets: leave unset, scripts will prompt ---
# KC_DB_PASSWORD=
# KC_BOOTSTRAP_ADMIN_PASSWORD=
# KNOX_OIDC_SECRET=
# GRAFANA_OIDC_SECRET=
# NEXTCLOUD_OIDC_SECRET=

# Grafana service for a Docker Swarm stack   (verified method: client secret passed as an environment variable)
# docs/services/grafana.md
#
# Merge the service into your existing monitoring stack, or deploy it into the same stack name
# WITHOUT --prune (services missing from this file are then left alone).
# ${GRAFANA_OIDC_SECRET} is deliberately NOT filled in by scripts/lib/common.sh render: docker stack
# deploy substitutes it from the shell, and it does NOT read a .env file (that was problem 31).
# scripts/grafana/01-deploy-stack.sh exports it for you. Use grafana-stack.docker-secret.yml.example
# instead if you do not want the secret visible in "docker service inspect".
version: "3.8"

networks:
  elk:
    external: true          # the overlay network shared with nginx and Prometheus

services:
  grafana:
    image: grafana/grafana:${GRAFANA_VERSION}
    volumes:
      - /data/grafana/data:/var/lib/grafana
      - /data/grafana/provisioning:/etc/grafana/provisioning
      - /data/grafana/dashboards:/var/lib/grafana/dashboards
    environment:
      - GF_SERVER_ROOT_URL=https://${GRAFANA_HOSTNAME}
      - GF_SERVER_DOMAIN=${GRAFANA_HOSTNAME}
      - GF_USERS_ALLOW_SIGN_UP=false
      # The built-in admin password is NOT set here: it was kept in the stack file in plain text during
      # the first deployment (security checklist item 12). Set it once in the UI or with grafana cli.
      - GF_AUTH_GENERIC_OAUTH_ENABLED=true
      - GF_AUTH_GENERIC_OAUTH_NAME=Keycloak
      - GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
      - GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=${GRAFANA_OIDC_SECRET}
      - GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
      - GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
      - GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://${SSO_HOSTNAME}/realms/${REALM}/protocol/openid-connect/auth
      - GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://${SSO_HOSTNAME}/realms/${REALM}/protocol/openid-connect/token
      - GF_AUTH_GENERIC_OAUTH_API_URL=https://${SSO_HOSTNAME}/realms/${REALM}/protocol/openid-connect/userinfo
      - GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
      - GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
      - GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
      # Administrators come from a Keycloak group; everybody else who signs in is a Viewer.
      - GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
      - "GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], '${GRAFANA_ADMIN_GROUP}') && 'GrafanaAdmin' || 'Viewer'"
      # Keycloak is the main login. The password form stays reachable at /login?disableAutoLogin=true.
      # Do NOT set disable_login_form: it would remove that fallback for everyone.
      - GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=true
      # Sign out also ends the Keycloak session. The return address must be a valid post logout URI.
      - "GF_AUTH_GENERIC_OAUTH_SIGNOUT_REDIRECT_URL=https://${SSO_HOSTNAME}/realms/${REALM}/protocol/openid-connect/logout?client_id=grafana&post_logout_redirect_uri=https%3A%2F%2F${GRAFANA_HOSTNAME}%2Flogin"
    networks:
      - elk
